{
  "name": "@alete-ai/edge",
  "version": "0.1.5",
  "description": "Content Extraction & Semantic Classification Library",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.browser.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "postbuild": "mkdir -p dist/model && cp src/model/m2v_embeddings.bin src/model/m2v_quant_meta.json dist/model/ && du -sh dist/*.js dist/*.cjs dist/model",
    "prepublishOnly": "pnpm build",
    "train:data:synthetic": "python3 training/generate_synthetic.py",
    "train:data:web": "pnpm tsx training/ingest_web.ts",
    "train:model": "pnpm tsx training/train_model.js",
    "train:quantize": "pnpm tsx training/quantize_embeddings.ts",
    "train": "pnpm train:data:synthetic && pnpm train:data:web && pnpm train:model && pnpm train:quantize"
  },
  "keywords": [
    "edge",
    "nlp",
    "extraction",
    "readability",
    "markdown"
  ],
  "author": "Stoyan Dimitrov <https://github.com/StoyanD>",
  "license": "AGPL-3.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hackylabs/deep-redact": "^3.0.5",
    "@mozilla/readability": "^0.6.0",
    "@yarflam/potion-base-8m": "^1.0.4",
    "dom-to-semantic-markdown": "^1.5.0",
    "linkedom": "^0.18.12",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-naive-bayes-text-classifier": "^2.2.1",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/jsdom": "^28.0.1",
    "@types/node-fetch": "^2.6.13",
    "@vitest/ui": "^4.1.5",
    "jsdom": "^29.0.2",
    "node-fetch": "^2.7.0",
    "onnxruntime-web": "^1.24.3",
    "ts-mockito": "^2.6.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
