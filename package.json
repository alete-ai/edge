{
  "name": "alete-edge-workspace",
  "version": "0.3.0",
  "description": "Workspace for Alete Edge packages",
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "publish:ts": "pnpm publish -r --tag beta --no-git-checks",
    "publish:swift": "git tag -a v$npm_package_version -m \"Release v$npm_package_version\" && git push origin v$npm_package_version",
    "publish:all": "pnpm run publish:ts && pnpm run publish:swift",
    "train:data:synthetic": "python3 training/generate_synthetic.py",
    "train:data:web": "pnpm tsx training/ingest_web.ts",
    "train:model": "pnpm tsx training/train_model.js",
    "train:quantize": "pnpm tsx training/quantize_embeddings.ts",
    "train": "pnpm train:data:synthetic && pnpm train:data:web && pnpm train:model && pnpm train:quantize"
  },
  "author": "Stoyan Dimitrov <https://github.com/StoyanD>",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@types/node-fetch": "^2.6.13",
    "@vitest/ui": "^4.1.5",
    "jsdom": "^29.0.2",
    "node-fetch": "^2.7.0",
    "onnxruntime-web": "^1.24.3",
    "ts-mockito": "^2.6.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
