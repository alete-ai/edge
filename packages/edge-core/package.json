{
  "name": "@alete-ai/edge-core",
  "version": "0.3.0",
  "description": "Core Extraction and Sanitization for Alete Edge",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./platform/*": {
      "types": "./dist/platform/*.d.ts",
      "import": "./dist/platform/*.js",
      "require": "./dist/platform/*.cjs"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup"
  },
  "keywords": [
    "edge",
    "extraction",
    "readability",
    "markdown"
  ],
  "author": "Stoyan Dimitrov <https://github.com/StoyanD>",
  "license": "AGPL-3.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hackylabs/deep-redact": "^3.0.5",
    "@mozilla/readability": "^0.6.0",
    "@yarflam/potion-base-8m": "^1.0.4",
    "dom-to-semantic-markdown": "^1.5.0",
    "linkedom": "^0.18.12"
  }
}
